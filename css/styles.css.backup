:root {
  --bg: #0b1020;
  --bg-alt: #111827;
  --panel: rgba(15, 23, 42, 0.8);
  --panel-soft: #f3f6fb;
  --card: #ffffff;
  --text: #dfe7f3;
  --muted: #b6c1d2;
  --line: rgba(148, 163, 184, 0.22);
  --brand: #7dd3fc;
  --brand-strong: #38bdf8;
  --accent: #a78bfa;
  --shadow: 0 18px 45px rgba(15, 23, 42, 0.25);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Inter", sans-serif;
  background:
    radial-gradient(circle at top left, rgba(56, 189, 248, 0.18), transparent 28%),
    radial-gradient(circle at bottom right, rgba(167, 139, 250, 0.18), transparent 26%),
    var(--bg);
  color: var(--text);
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

.site {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 72px;
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 24px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-size: 0.8rem;
  letter-spacing: 0.22rem;
  text-transform: uppercase;
  font-weight: 700;
  color: #f8fbff;
}

.dot-pair {
  position: relative;
  width: 16px;
  height: 16px;
  display: inline-block;
}

.dot-pair .c1,
.dot-pair .c2 {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  top: 3px;
}

.dot-pair .c1 {
  left: 0;
  background: var(--brand);
  box-shadow: 0 0 18px rgba(125, 211, 252, 0.8);
}

.dot-pair .c2 {
  right: 0;
  background: var(--accent);
  box-shadow: 0 0 18px rgba(167, 139, 250, 0.8);
}

.links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
}

.links a {
  position: relative;
  font-size: 0.78rem;
  letter-spacing: 0.12rem;
  text-transform: lowercase;
  color: var(--muted);
  transition: color 0.2s ease;
}

.links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, var(--brand), var(--accent));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.2s ease;
}

.links a:hover,
.links a:focus-visible {
  color: #f8fbff;
}

.links a:hover::after,
.links a:focus-visible::after {
  transform: scaleX(1);
}

.hero {
  padding-top: 50px;
}

.hero-inner {
  padding: 72px 24px 56px;
  background: linear-gradient(135deg, rgba(19, 27, 46, 0.94), rgba(13, 18, 30, 0.9));
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

.hero-inner::before,
.hero-inner::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  filter: blur(20px);
  opacity: 0.7;
}

.hero-inner::before {
  width: 260px;
  height: 260px;
  background: rgba(56, 189, 248, 0.18);
  top: -90px;
  right: 12%;
}

.hero-inner::after {
  width: 220px;
  height: 220px;
  background: rgba(167, 139, 250, 0.18);
  bottom: -70px;
  left: 10%;
}

.hero-title,
.section-title {
  font-family: "Space Grotesk", sans-serif;
  letter-spacing: -0.05em;
}

.hero-title {
  position: relative;
  z-index: 1;
  max-width: 800px;
  margin: 0 0 18px;
  font-size: clamp(2.5rem, 5vw, 5rem);
  line-height: 0.94;
  color: #f9fbff;
}

.hero-subtitle {
  position: relative;
  z-index: 1;
  max-width: 700px;
  margin: 0 0 30px;
  font-size: 1.1rem;
  color: var(--muted);
}

.hero-cta {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 22px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--brand-strong), var(--accent));
  color: #06111f;
  font-weight: 700;
  box-shadow: 0 12px 30px rgba(56, 189, 248, 0.25);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.hero-cta:hover,
.hero-cta:focus-visible {
  transform: translateY(-1px);
  box-shadow: 0 16px 36px rgba(56, 189, 248, 0.35);
}

main {
  display: grid;
  gap: 28px;
  width: min(1200px, calc(100% - 32px));
  margin: 32px auto 0;
  padding-bottom: 80px;
}

main > section {
  background: rgba(17, 24, 39, 0.75);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 30px 28px;
  box-shadow: var(--shadow);
}

.section-title {
  margin: 0 0 18px;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  color: #f3f7ff;
}

.section-description,
.team-member-role,
.skills-list,
.work-list {
  color: var(--muted);
}

.team-members {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 22px;
  margin-top: 18px;
}

.team-member {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 20px;
  padding: 18px;
  text-align: center;
}

.team-member-photo {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 50%;
  margin: 0 auto 16px;
  border: 3px solid rgba(125, 211, 252, 0.45);
  box-shadow: 0 14px 28px rgba(15, 23, 42, 0.2);
}

.team-member h3 {
  margin: 0;
  font-family: "Space Grotesk", sans-serif;
  font-size: 1.6rem;
  color: #ffffff;
}

.team-member-role {
  margin: 8px 0 0;
  font-size: 0.95rem;
}

.skills-list,
.work-list {
  margin: 0;
  padding-left: 20px;
  font-size: 1rem;
}

.skills-list li,
.work-list li {
  margin-bottom: 10px;
}

.work-list a {
  color: var(--brand);
  font-weight: 600;
}

/* Contact form and footer styles added to match HTML changes */
.contact .contact-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  color: var(--muted);
}

.contact .contact-list li {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.contact label {
  font-weight: 600;
  color: #f3f7ff;
  margin-right: 8px;
}

.contact input[type="email"] {
  min-width: 220px;
  max-width: 420px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(255,255,255,0.03);
  color: var(--text);
  outline: none;
}

.contact input[type="email"]::placeholder {
  color: var(--muted);
}

.contact button[type="submit"] {
  appearance: none;
  -webkit-appearance: none;
  border: none;
  padding: 10px 16px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--brand-strong), var(--accent));
  color: #06111f;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.contact button[type="submit"]:hover {
  transform: translateY(-2px);
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px;
}

.social-links {
  display: flex;
  gap: 12px;
  align-items: center;
  margin: 0;
  padding: 0;
  list-style: none;
}

.social-links a {
  color: var(--muted);
  padding: 8px 10px;
  border-radius: 8px;
  transition: background 0.12s ease, color 0.12s ease;
}

.social-links a:hover {
  background: rgba(255,255,255,0.03);
  color: #f3f7ff;
}

@media (max-width: 700px) {
  .nav-inner {
    flex-direction: column;
    align-items: flex-start;
  }

  .links {
    gap: 12px 16px;
  }

  .site,
  main {
    width: min(100% - 20px, 1200px);
  }

  main > section {
    padding: 22px 18px;
  }

  .hero-inner {
    padding: 50px 18px 38px;
  }
}
